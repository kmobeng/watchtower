# WatchTower environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
PORT=3000
NODE_ENV=development
# Base URL used to build links in emails (e.g. password-reset links)
APP_URL=http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/watchtower

# --- Redis (used by the app and BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Access token signing (e.g. 15m)
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
# Refresh token signing (e.g. 14d) and cookie lifetime in days
REFRESH_JWT_SECRET=change-me
REFRESH_JWT_EXPIRES_IN=14d
REFRESH_JWT_COOKIE_EXPIRES_IN=14

# --- Email ---
# Provider: dev (Mailpit over SMTP) or resend.
EMAIL_PROVIDER=dev
# SMTP host/port for the dev sender. Defaults to localhost:1025; override to
# `mailpit` when running inside Docker Compose.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# Sender address for transactional email. The dev sender always uses plain
# SMTP and reads no SMTP credentials.
EMAIL_FROM=WatchTower <noreply@watchtower.local>
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# --- SMS ---
# Provider: dev (logs the message) or twilio.
SMS_PROVIDER=dev
# Required when SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Multi-region checkers ---
# Regions the API schedules checks for (comma-separated). Every region needs a
# worker process running with CHECK_REGION set to that value.
CHECK_REGIONS=local
# Region this worker process probes. Required on the worker; ignored by the API.
# Must be one of CHECK_REGIONS when that is set.
CHECK_REGION=local
# Regions that must agree before an incident opens or resolves. Defaults to a
# strict majority: floor(n/2)+1. Must be between 1 and the region count.
# CHECK_QUORUM=1
# How long a worker's claim on a scheduled check survives in Redis. Duplicate
# deliveries of the same (region, monitor, slot) are dropped until it expires.
# Defaults to 300 seconds.
# CHECK_LOCK_TTL_SECONDS=300
# Flapping detection: more than FLAP_MAX_CHANGES up/down transitions inside
# FLAP_WINDOW_SECONDS marks a monitor as flapping and suppresses escalation
# until it stops changing state. Defaults: 5 changes over 1800 seconds.
# FLAP_MAX_CHANGES=5
# FLAP_WINDOW_SECONDS=1800

# --- Live dashboard (Socket.IO) ---
# Comma-separated origins allowed to open the /dashboard namespace. Defaults to
# * for development. Set explicit origins in production.
# WS_CORS_ORIGIN=http://localhost:5173
