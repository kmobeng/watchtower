generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum HttpMethod {
  GET
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum NotificationChannelType {
  EMAIL
  SMS
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  name              String?
  password          String
  role              Role      @default(USER)
  provider          String?   @default("local")
  isEmailVerified   Boolean   @default(false)
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  monitors            Monitor[]
  escalationPolicies  EscalationPolicy[]
  notificationChannels NotificationChannel[]
}

model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, token])
}

model Monitor {
  id                 String            @id @default(uuid())
  userId             String            @map("user_id")
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  escalationPolicyId String?           @map("escalation_policy_id")
  escalationPolicy   EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id], onDelete: SetNull)
  url                String
  method             HttpMethod        @default(GET)
  intervalSeconds    Int               @map("interval_seconds")
  timeoutMs          Int               @default(10000) @map("timeout_ms")
  failureThreshold   Int               @default(3) @map("failure_threshold")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  checks             Check[]
  incidents          Incident[]

  @@unique([userId, url])
  @@index([userId])
  @@index([escalationPolicyId])
  @@map("monitors")
}

model Check {
  id             String   @id @default(uuid())
  monitorId      String   @map("monitor_id")
  monitor        Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  checkedAt      DateTime @default(now()) @map("checked_at")
  region         String   @default("local")
  statusCode     Int?     @map("status_code")
  responseTimeMs Int      @map("response_time_ms")
  isUp           Boolean  @map("is_up")
  timedOut       Boolean  @default(false) @map("timed_out")
  error          String?

  @@index([monitorId, region, checkedAt(sort: Desc)])
  @@map("checks")
}

model Incident {
  id               String         @id @default(uuid())
  monitorId        String         @map("monitor_id")
  monitor          Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status           IncidentStatus @default(OPEN)
  cause            String
  openedByCheckId  String?        @map("opened_by_check_id")
  closedByCheckId  String?        @map("closed_by_check_id")
  startedAt        DateTime       @default(now()) @map("started_at")
  acknowledgedAt   DateTime?      @map("acknowledged_at")
  resolvedAt       DateTime?      @map("resolved_at")
  downtimeSeconds  Int?           @map("downtime_seconds")
  escalationStep   Int            @default(0) @map("escalation_step")
  nextEscalationAt DateTime?      @map("next_escalation_at")

  notificationDeliveries NotificationDelivery[]

  @@index([monitorId, startedAt(sort: Desc)])
  @@index([status, nextEscalationAt])
  @@map("incidents")
}

model EscalationPolicy {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // Ordered steps: [{ afterMinutes: number, notifyChannelId: string }]
  steps     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  monitors Monitor[]

  @@index([userId])
  @@map("escalation_policies")
}

model NotificationChannel {
  id          String                  @id @default(uuid())
  userId      String                  @map("user_id")
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationChannelType
  destination String
  label       String?
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  deliveries NotificationDelivery[]

  @@index([userId])
  @@map("notification_channels")
}

model NotificationDelivery {
  id          String                     @id @default(uuid())
  incidentId  String                     @map("incident_id")
  incident    Incident                   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channelId   String                     @map("channel_id")
  channel     NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Restrict)
  step        Int
  // Snapshots so editing or deleting a channel never rewrites history.
  channelType NotificationChannelType    @map("channel_type")
  destination String
  status      NotificationDeliveryStatus @default(PENDING)
  attempts    Int                        @default(0)
  claimedAt   DateTime?                  @map("claimed_at")
  sentAt      DateTime?                  @map("sent_at")
  lastError   String?                    @map("last_error")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  // The idempotency gate: one delivery per incident/channel/step.
  @@unique([incidentId, channelId, step])
  @@index([incidentId])
  @@index([status, claimedAt])
  @@map("notification_deliveries")
}
